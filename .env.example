# Public tracking IDs (all optional; leave unset to disable that integration).
# Never commit real secrets. NEXT_PUBLIC_* values are visible in the browser by design.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Optional: conversion label for a Google Ads "affiliate click" conversion action
NEXT_PUBLIC_GOOGLE_ADS_CLICK_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Affiliate routing. Product deep links are ON by default (each product CTA goes to its own
# Bodegacooler.com product page with ?click_id=... appended). Set to "false" to send every CTA to
# DEFAULT_AFFILIATE_URL instead. General CTAs always use DEFAULT_AFFILIATE_URL.
NEXT_PUBLIC_USE_PRODUCT_DEEP_LINKS=true
