# Public tracking IDs (all optional; leave unset to disable that integration).
# Never commit real secrets. NEXT_PUBLIC_* values are visible in the browser by design.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Optional: conversion label for a Google Ads "affiliate click" conversion action
NEXT_PUBLIC_GOOGLE_ADS_CLICK_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Affiliate routing. Default (unset/false): every CTA goes to DEFAULT_AFFILIATE_URL.
# Set to "true" ONLY after the merchant/network confirms that ?click_id= is honoured
# on product-page landings. Then product CTAs deep-link to the matching product page.
NEXT_PUBLIC_USE_PRODUCT_DEEP_LINKS=false
